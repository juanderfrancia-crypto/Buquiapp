{
  "expo": {
    "sdkVersion": "54.0.0",
    "name": "Buqui",
    "slug": "barberapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "barberapp",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icono.png",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.buqui.app",
      "icon": "./assets/images/icono.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icono.png",
        "backgroundColor": "#2F6BFF"
      },
      "package": "com.buqui.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2F6BFF",
          "disableAutoRegistration": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5be2bfbc-14af-428c-a619-01971f296d04"
      }
    },
    "owner": "traive"
  }
}
