{
  "expo": {
    "sdkVersion": "54.0.0",
    "name": "Buqui",
    "slug": "barberapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "buqui",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icono.png",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.buqui.app",
      "icon": "./assets/images/icono.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icono.png",
        "backgroundColor": "#2F6BFF"
      },
      "package": "com.buqui.app",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "buqui"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2F6BFF",
          "disableAutoRegistration": true
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "privacyPolicyUrl": "https://juanderfrancia-crypto.github.io/Buquiapp/privacy-policy.html",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5be2bfbc-14af-428c-a619-01971f296d04"
      }
    },
    "owner": "traive"
  }
}
